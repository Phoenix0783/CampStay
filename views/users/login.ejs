<% layout('layouts/boilerplate')%>

<div class="auth-layout">
    <section class="auth-card">
        <header class="auth-card-header">
            <span class="page-eyebrow">Welcome back</span>
            <h1>Log in</h1>
            <p>Your next great campsite is waiting.</p>
        </header>
        <div class="auth-card-body">
            <form action="/login" method="POST" class="validated-form" novalidate>
    <div class="mb-3">
        <label class="form-label" for="username">Username</label>
        <input class="form-control" type="text" id="username" name="username" autofocus required>
        <div class="valid-feedback">
            Looks good!
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input class="form-control" type="password" id="password" name="password" required>
        <div class="valid-feedback">
            Looks good!
        </div>
    </div>
                <button class="btn auth-submit btn-block">Log in</button>
            </form>
        </div>
    </section>
</div>