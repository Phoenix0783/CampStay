<% layout('layouts/boilerplate')%>

<div class="auth-layout">
    <section class="auth-card">
        <header class="auth-card-header">
            <span class="page-eyebrow">Join the community</span>
            <h1>Create your account</h1>
            <p>Save your favorite spots and share your own.</p>
        </header>
        <div class="auth-card-body">
            <form action="/register" method="POST" class="validated-form" novalidate>
    <div class="mb-3">
        <label class="form-label" for="username">Username</label>
        <input class="form-control" type="text" id="username" name="username" autofocus required>
        <div class="valid-feedback">
            Looks good!
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input class="form-control" type="email" id="email" name="email" required>
        <div class="valid-feedback">
            Looks good!
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input class="form-control" type="password" id="password" name="password" required>
        <div class="valid-feedback">
            Looks good!
        </div>
    </div>
                <button class="btn auth-submit btn-block">Create account</button>
            </form>
        </div>
    </section>
</div>


